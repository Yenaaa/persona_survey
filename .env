# mock / openai / anthropic / google 중 하나.
# API 키 없이 파이프라인만 먼저 테스트하고 싶으면 LLM_PROVIDER=mock
LLM_PROVIDER=anthropic
# provider가 지원하는 모델명으로. 예: gpt-4o-mini / claude-sonnet-5 / gemini-2.5-flash
MODEL_NAME=claude-sonnet-5


PERSONA_DATASET_NAME=nvidia/Nemotron-Personas-Korea
PERSONA_DATASET_SPLIT=train

FIELD_SET=custom

N_PERSONAS=10
REPEATS_PER_PERSONA=1
RANDOM_SEED=42

OUTPUT_DIR=results
# RESUME_RUN_ID=20260922_143000_openai_gpt-4o-mini_default
